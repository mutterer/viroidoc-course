   "source": [
    "from skimage.io import imread\n",
    "import numpy as np\n",
    "img = imread('./../data/blobs.tif')\n",
    "mask = img > 40\n",
    "y, x = np.nonzero(mask)\n",
    "cx = x.mean()\n",
    "cy = y.mean()"
   ]
